{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "User information and roles",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Firebase Auth UID" },
        "name": { "type": "string", "description": "Full name" },
        "email": { "type": "string", "format": "email" },
        "role": { "type": "string", "enum": ["ADMIN", "DELEGATE", "STUDENT"] },
        "class_name": { "type": "string", "description": "Class name (e.g., GI3)" },
        "is_class_account": { "type": "boolean" },
        "password_changed": { "type": "boolean" },
        "avatar": { "type": "string", "format": "uri" },
        "created_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "email", "role", "class_name"]
    },
    "Announcement": {
      "title": "Announcement",
      "description": "Class news and updates",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "content": { "type": "string" },
        "author": { "type": "string" },
        "priority": { "type": "string", "enum": ["normal", "important", "urgent"] },
        "className": { "type": "string" },
        "link": { "type": "string", "format": "uri" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "content", "priority", "className"]
    },
    "SchoolClass": {
      "title": "School Class",
      "description": "Class definition and access codes",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "class_email": { "type": "string", "format": "email" },
        "password": { "type": "string" },
        "delegate_code": { "type": "string" },
        "created_by": { "type": "string" },
        "created_at": { "type": "string", "format": "date-time" },
        "studentCount": { "type": "number" },
        "color": { "type": "string" }
      },
      "required": ["name", "class_email", "delegate_code"]
    },
    "Post": {
      "title": "Forum Post",
      "description": "A post in the forum",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "content": { "type": "string" },
        "userId": { "type": "string" },
        "authorName": { "type": "string" },
        "className": { "type": "string" },
        "votesScore": { "type": "number" },
        "commentsCount": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "content", "userId", "authorName", "className"]
    },
    "Comment": {
      "title": "Forum Comment",
      "description": "A comment on a post or another comment",
      "type": "object",
      "properties": {
        "postId": { "type": "string" },
        "parentId": { "type": "string" },
        "userId": { "type": "string" },
        "authorName": { "type": "string" },
        "content": { "type": "string" },
        "votesScore": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["postId", "userId", "authorName", "content"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User documents"
    },
    "/announcements/{annId}": {
      "schema": "Announcement",
      "description": "Class announcements"
    },
    "/classes/{classId}": {
      "schema": "SchoolClass",
      "description": "Class metadata"
    },
    "/posts/{postId}": {
      "schema": "Post",
      "description": "Forum posts"
    },
    "/comments/{commentId}": {
      "schema": "Comment",
      "description": "Forum comments"
    },
    "/votes/{voteId}": {
      "schema": "Vote",
      "description": "User votes on posts and comments"
    },
    "/notifications/{notifId}": {
      "schema": "ForumNotification",
      "description": "User notifications"
    }
  }
}
