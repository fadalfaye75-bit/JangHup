{
  "entities": {
    "user": {
      "title": "User Profile",
      "description": "Information about a user",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "avatar": { "type": "string", "format": "uri" },
        "role": { "type": "string", "enum": ["admin", "delegate", "student"] },
        "class_name": { "type": "string" },
        "points": { "type": "number" },
        "badge": { "type": "string" }
      },
      "required": ["id", "name", "email", "role", "class_name"]
    },
    "meeting": {
      "title": "Meeting",
      "description": "Visioconférence session",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "platform": { "type": "string" },
        "url": { "type": "string", "format": "uri" },
        "time": { "type": "string", "format": "date-time" },
        "className": { "type": "string" },
        "userId": { "type": "string" }
      },
      "required": ["title", "platform", "url", "time", "className", "userId"]
    },
    "chat_room": {
      "title": "Chat Room",
      "description": "A group for chatting",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "className": { "type": "string" },
        "lastMessage": { "type": "string" },
        "lastMessageTime": { "type": "string" }
      }
    },
    "message": {
      "title": "Chat Message",
      "description": "A message within a chat room",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "roomId": { "type": "string" },
        "userId": { "type": "string" },
        "text": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "type": { "type": "string", "enum": ["text", "sticker", "media"] },
        "class_name": { "type": "string" }
      }
    },
    "announcement": {
      "title": "Announcement",
      "description": "A class-wide notice",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "content": { "type": "string" },
        "className": { "type": "string" },
        "priority": { "type": "string", "enum": ["normal", "important", "urgent"] },
        "createdAt": { "type": "string" }
      }
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "user",
      "description": "User profiles"
    },
    "/chat_rooms/{roomId}": {
      "schema": "chat_room",
      "description": "Metadata for chat channels"
    },
    "/chat_rooms/{roomId}/messages/{messageId}": {
      "schema": "message",
      "description": "Individual messages in a room"
    },
    "/announcements/{annId}": {
      "schema": "announcement",
      "description": "Class announcements"
    },
    "/meetings/{meetId}": {
      "schema": "meeting",
      "description": "Virtual meeting links"
    }
  }
}
