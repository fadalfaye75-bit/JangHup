rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Helper Functions
    // ===============================================================
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isAuthenticated() && 
        ((exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
          getUserData().get('role', '') == 'ADMIN') ||
         (request.auth.token.get('email', '') == "fadalfaye75@gmail.com" && 
          request.auth.token.get('email_verified', false) == true));
    }

    function isDelegate() {
      return isAuthenticated() && 
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         (getUserData().get('role', '') == 'DELEGATE' || getUserData().get('role', '') == 'ADMIN'));
    }

    function getUserClass() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid)) ? 
        getUserData().get('class_name', getUserData().get('className', '')) : '';
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /users/{userId} {
      allow read: if isAuthenticated(); 
      allow create: if (isOwner(userId) && 
                      request.resource.data.role == 'STUDENT' &&
                      request.resource.data.is_class_account == true) || 
                      (isOwner(userId) && isAdmin());
      allow update: if isOwner(userId) && 
                      (
                        // Allow student to become delegate if they provide the correct code
                        // In a real app, this would be a Cloud Function.
                        // Here we allow role update if not becoming ADMIN.
                        (request.resource.data.role == 'DELEGATE' && resource.data.role == 'STUDENT') ||
                        (request.resource.data.role == resource.data.role) || 
                        isAdmin()
                      );
    }

    match /announcements/{annId} {
      allow read: if isAuthenticated() && (isAdmin() || resource.data.className == getUserClass());
      allow create: if isDelegate() || isAdmin();
      allow update: if isAdmin() || (isDelegate() && resource.data.userId == request.auth.uid);
      allow delete: if isAdmin() || (isDelegate() && resource.data.userId == request.auth.uid);
    }

    match /classes/{classId} {
      allow read: if isAuthenticated();
      allow create, delete: if isAdmin();
      allow update: if isAdmin();
    }

    match /exams/{examId} {
      allow read: if isAuthenticated() && (isAdmin() || resource.data.className == getUserClass());
      allow write: if isDelegate() || isAdmin();
    }

    match /meetings/{meetingId} {
      allow read: if isAuthenticated() && (isAdmin() || resource.data.className == getUserClass());
      allow write: if isDelegate() || isAdmin();
    }

    match /polls/{pollId} {
      allow read: if isAuthenticated() && (isAdmin() || resource.data.className == getUserClass());
      allow create: if isDelegate() || isAdmin();
      allow update: if isAdmin() || (isDelegate() && resource.data.userId == request.auth.uid) ||
                      (isAuthenticated() && 
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['totalVotes']) &&
                       math.abs(request.resource.data.totalVotes - resource.data.totalVotes) == 1);
      allow delete: if isAdmin() || (isDelegate() && resource.data.userId == request.auth.uid);
    }

    match /resources/{resId} {
      allow read: if isAuthenticated() && (isAdmin() || resource.data.className == getUserClass());
      allow write: if isDelegate() || isAdmin();
    }

    match /posts/{postId} {
      allow read: if isAuthenticated() && (isAdmin() || resource.data.className == getUserClass());
      allow create: if isAuthenticated() && request.resource.data.className == getUserClass();
      allow update: if isAdmin() || isOwner(resource.data.userId) || 
                      (isAuthenticated() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['votesScore', 'commentsCount', 'updatedAt']));
      allow delete: if isAdmin() || isOwner(resource.data.userId);
    }

    match /comments/{commentId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAdmin() || isOwner(resource.data.userId) ||
                      (isAuthenticated() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['votesScore', 'updatedAt']));
      allow delete: if isAdmin() || isOwner(resource.data.userId);
    }

    match /notifications/{notifId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    match /activity_logs/{logId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    match /announcement_read_statuses/{statusId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create, update: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    match /votes/{voteId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
    }

    match /poll_options/{optionId} {
      allow read: if isAuthenticated();
      allow create: if isDelegate() || isAdmin();
      allow update: if isAuthenticated() && 
                      request.resource.data.diff(resource.data).affectedKeys().hasOnly(['votes']) &&
                      math.abs(request.resource.data.votes - resource.data.votes) == 1;
      allow delete: if isDelegate() || isAdmin();
    }

    match /poll_votes/{voteId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }
  }
}
