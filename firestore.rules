rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Helper Functions
    // ===============================================================
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && 
        ((exists(/databases/$(database)/documents/profiles/$(request.auth.uid)) && 
          get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.role == 'ADMIN') ||
         (request.auth.token.email == "fadalfaye75@gmail.com" && request.auth.token.email_verified == true));
    }

    function isDelegate() {
      return isAuthenticated() && 
        ((exists(/databases/$(database)/documents/profiles/$(request.auth.uid)) && 
          get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.role == 'DELEGATE') || isAdmin());
    }

    function getUserClass() {
      return get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.className;
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /profiles/{userId} {
      allow read: if isAuthenticated(); 
      allow create: if isOwner(userId) && 
                      request.resource.data.role in ['STUDENT', 'DELEGATE', 'ADMIN'] &&
                      (request.resource.data.role == 'STUDENT' || isAdmin());
      allow update: if isOwner(userId) && 
                      (request.resource.data.role == resource.data.role || isAdmin()) &&
                      (!('points' in request.resource.data) || request.resource.data.points == resource.data.points) &&
                      (!('badges' in request.resource.data) || request.resource.data.badges == resource.data.badges);
    }

    match /announcements/{annId} {
      allow read: if isAuthenticated() && (resource.data.className == getUserClass() || isAdmin());
      allow create: if isDelegate() || isAdmin();
      allow update: if isAdmin() || (isDelegate() && resource.data.userId == request.auth.uid);
      allow delete: if isAdmin() || (isDelegate() && resource.data.userId == request.auth.uid);
    }

    match /announcement_read_statuses/{statusId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && 
                      statusId == request.auth.uid + "_" + request.resource.data.announcementId &&
                      request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    match /classes/{classId} {
      allow read: if isAuthenticated();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (isDelegate() && resource.data.name == getUserClass());
    }

    match /exams/{examId} {
      allow read: if isAuthenticated() && (resource.data.className == getUserClass() || isAdmin());
      allow write: if isDelegate() || isAdmin();
    }

    match /meetings/{meetingId} {
      allow read: if isAuthenticated() && (resource.data.className == getUserClass() || isAdmin());
      allow write: if isDelegate() || isAdmin();
    }

    match /polls/{pollId} {
      allow read: if isAuthenticated() && (resource.data.className == getUserClass() || isAdmin());
      allow create: if isDelegate() || isAdmin();
      allow update: if isAdmin() || (isDelegate() && resource.data.userId == request.auth.uid) ||
                      (isAuthenticated() && 
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['totalVotes']) &&
                       math.abs(request.resource.data.totalVotes - resource.data.totalVotes) == 1) ||
                      (isAuthenticated() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isActive']) && (isDelegate() || isAdmin()));
      allow delete: if isAdmin() || (isDelegate() && resource.data.userId == request.auth.uid);
    }

    match /poll_options/{optionId} {
      allow read: if isAuthenticated();
      allow update: if isAuthenticated() && 
                      request.resource.data.diff(resource.data).affectedKeys().hasOnly(['votes']) &&
                      math.abs(request.resource.data.votes - resource.data.votes) == 1;
      allow create: if isDelegate() || isAdmin();
      allow delete: if isAdmin() || (isDelegate() && get(/databases/$(database)/documents/polls/$(resource.data.pollId)).data.userId == request.auth.uid);
    }

    match /poll_votes/{voteId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && 
                      voteId == request.auth.uid + "_" + request.resource.data.pollId &&
                      request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['optionId', 'updatedAt']);
      allow delete: if isAdmin() || (isDelegate() && get(/databases/$(database)/documents/polls/$(resource.data.pollId)).data.userId == request.auth.uid) || (isAuthenticated() && resource.data.userId == request.auth.uid);
    }

    match /resources/{resId} {
      allow read: if isAuthenticated() && (resource.data.className == getUserClass() || isAdmin());
      allow write: if isDelegate() || isAdmin();
    }

    match /notifications/{notifId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']);
      allow delete: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
    }

    match /posts/{postId} {
      allow read: if isAuthenticated() && (resource.data.className == getUserClass() || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.className == getUserClass();
      allow update: if isAdmin() || isOwner(resource.data.userId) || 
                      (isAuthenticated() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['votesScore', 'commentsCount', 'updatedAt']));
      allow delete: if isAdmin() || isOwner(resource.data.userId);
    }

    match /comments/{commentId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAdmin() || isOwner(resource.data.userId) ||
                      (isAuthenticated() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['votesScore', 'updatedAt']));
      allow delete: if isAdmin() || isOwner(resource.data.userId);
    }

    match /votes/{voteId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && voteId == request.auth.uid + "_" + request.resource.data.targetId;
      allow update: if isOwner(resource.data.userId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['type', 'updatedAt']);
      allow delete: if isOwner(resource.data.userId);
    }

    match /activity_logs/{logId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if isAuthenticated();
    }
  }
}
