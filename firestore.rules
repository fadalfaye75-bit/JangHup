rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: users
    // Document ID: auth.uid
    // Fields:
    //   - name: string (required)
    //   - email: string (required)
    //   - role: string (student, delegate, admin)
    //   - class_name: string (required)
    //   - points: number (immutable for students)
    //
    // Collection: messages
    // Fields:
    //   - text: string
    //   - type: string (text, sticker, media)
    //   - userId: string
    //   - className: string (scoping)
    //   - createdAt: timestamp
    //
    // ===============================================================

    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserData() {
      let path = /databases/$(database)/documents/users/$(request.auth.uid);
      return exists(path) ? get(path).data : null;
    }

    function isAdmin() {
      let data = getUserData();
      return isAuthenticated() && (
        (data != null && ('role' in data) && (data.role == 'admin' || data.role == 'ADMIN')) ||
        (request.auth.token.email == "fadalfaye75@gmail.com" && request.auth.token.email_verified == true)
      );
    }

    function isDelegate() {
      let data = getUserData();
      return isAuthenticated() && data != null && ('role' in data) && (data.role == 'delegate' || data.role == 'DELEGATE');
    }

    function sameClass(className) {
      let data = getUserData();
      return data != null && ('class_name' in data) && data.class_name == className;
    }

    // Validation Functions
    function isValidUser(data) {
      return data.keys().hasAll(['name', 'email', 'class_name', 'role']) &&
             data.name is string && data.name.size() < 100 &&
             data.email is string &&
             data.role in ['student', 'delegate', 'admin', 'STUDENT', 'DELEGATE', 'ADMIN'] &&
             data.class_name is string;
    }

    function isValidMessage(data) {
      return data.keys().hasAll(['userId', 'className', 'type', 'createdAt']) &&
             data.userId == request.auth.uid &&
             data.className is string &&
             data.type in ['text', 'sticker', 'media', 'image', 'file'] &&
             (!('text' in data) || (data.text is string && data.text.size() < 5000));
    }

    // Rules
    
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId) && isValidUser(request.resource.data);
      allow update: if isAuthenticated() && (
        (isOwner(userId) && 
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'avatar', 'bio', 'points', 'badges', 'theme', 'password_changed', 'updatedAt', 'updated_at', 'class_name']) &&
         isValidUser(request.resource.data)) ||
        (isOwner(userId) &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'updated_at', '_delegateCode']) &&
         request.resource.data.role in ['delegate', 'DELEGATE'] &&
         '_delegateCode' in request.resource.data &&
         exists(/databases/$(database)/documents/delegate_codes/$(request.resource.data._delegateCode)) &&
         get(/databases/$(database)/documents/delegate_codes/$(request.resource.data._delegateCode)).data.className == resource.data.class_name &&
         isValidUser(request.resource.data)) ||
        (isOwner(userId) &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'class_name', 'updated_at']) &&
         request.resource.data.role in ['student', 'STUDENT'] &&
         request.resource.data.class_name == "" &&
         isValidUser(request.resource.data)) ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    match /users_public/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId) || isAdmin();
    }

    match /classes/{classId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /class_secrets/{classId} {
      allow read: if isAdmin() || isDelegate();
      allow write: if isAdmin();
    }

    match /messages/{msgId} {
      allow read: if isAuthenticated() && (isAdmin() || sameClass(resource.data.className));
      allow create: if isAuthenticated() && isValidMessage(request.resource.data) && sameClass(request.resource.data.className);
      allow update: if isAuthenticated() && (
        isAdmin() || 
        resource.data.userId == request.auth.uid ||
        (sameClass(resource.data.className) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions', 'readBy']))
      );
      allow delete: if isAuthenticated() && (isAdmin() || (resource.data.userId == request.auth.uid));
    }

    match /meetings/{meetId} {
      allow read: if isAuthenticated() && (isAdmin() || sameClass(resource.data.className));
      allow write: if isAuthenticated() && (isAdmin() || isDelegate() || (resource != null && resource.data.userId == request.auth.uid) || (request.resource != null && request.resource.data.userId == request.auth.uid));
    }

    match /typing/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    match /announcements/{annId} {
      allow read: if isAuthenticated() && (isAdmin() || sameClass(resource.data.className));
      allow write: if isAdmin() || isDelegate();
    }

    match /announcement_read_statuses/{statusId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create, update: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow delete: if isAdmin();
    }

    match /exams/{examId} {
      allow read: if isAuthenticated() && (isAdmin() || sameClass(resource.data.className));
      allow write: if isAdmin() || isDelegate();
    }

    match /resources/{resId} {
      allow read: if isAuthenticated() && (isAdmin() || sameClass(resource.data.className));
      allow write: if isAdmin() || isDelegate();
    }

    match /polls/{pollId} {
      allow read: if isAuthenticated() && (isAdmin() || sameClass(resource.data.className));
      allow update: if isAuthenticated() && (
        isAdmin() || 
        isDelegate() || 
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['totalVotes', 'updatedAt']) &&
          (request.resource.data.totalVotes == resource.data.totalVotes + 1 || request.resource.data.totalVotes == resource.data.totalVotes)
        )
      );
      allow create, delete: if isAdmin() || isDelegate();
    }

    match /poll_options/{optId} {
      allow read: if isAuthenticated();
      allow update: if isAuthenticated() && (
        isAdmin() || 
        isDelegate() || 
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['votes']) &&
          (request.resource.data.votes == resource.data.votes + 1 || request.resource.data.votes == resource.data.votes - 1)
        )
      );
      allow create, delete: if isAdmin() || isDelegate();
    }

    match /poll_votes/{voteId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && request.resource.data.userId == request.auth.uid && voteId == request.auth.uid + "_" + request.resource.data.pollId;
      allow delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    match /results/{resId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin() || isDelegate());
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /notifications/{notifId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if isAuthenticated();
    }

    match /activity_logs/{logId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /registration_codes/{codeId} {
      allow get: if true;
      allow list, write: if isAdmin();
    }

    match /delegate_codes/{codeId} {
      allow get: if isAuthenticated();
      allow list, write: if isAdmin();
    }

    // Default deny
    match /{path=**} {
      allow read, write: if false;
    }
  }
}
