rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Helper Functions
    // ===============================================================
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isAuthenticated() && 
        (request.auth.token.email == "fadalfaye75@gmail.com" || 
         (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
          getUserData().get('role', '') == 'ADMIN'));
    }

    function isDelegate() {
      return isAuthenticated() && 
        (isAdmin() || 
         (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
          getUserData().get('role', '') == 'DELEGATE'));
    }

    function isValidString(val, maxLen) {
      return val is string && val.size() <= maxLen;
    }

    function getUserClass() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid)) ? 
        getUserData().get('class_name', '') : '';
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin(); 
      allow create: if (isOwner(userId) && 
                      request.resource.data.role == 'STUDENT') || 
                      (isOwner(userId) && isAdmin());
      allow update: if isAdmin() || (isOwner(userId) && 
                      (
                        (request.resource.data.role == 'DELEGATE' && resource.data.role == 'STUDENT') ||
                        (request.resource.data.role == resource.data.role)
                      ));
      allow delete: if isAdmin();
    }

    match /users_public/{userId} {
      allow get, list: if isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isAdmin() || (isAuthenticated() && request.auth.uid == userId);
      allow delete: if isAdmin();
    }

    match /announcements/{annId} {
      allow read: if isAuthenticated() && (isAdmin() || resource.data.className == getUserClass());
      allow create: if isDelegate() || isAdmin();
      allow update, delete: if isAdmin() || (isDelegate() && resource.data.userId == request.auth.uid);
    }

    match /classes/{classId} {
      allow get: if true;
      allow list: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /class_secrets/{classId} {
      allow read, write: if isAdmin() || (isAuthenticated() && getUserClass() == get(/databases/$(database)/documents/classes/$(classId)).data.name && isDelegate());
    }

    match /registration_codes/{code} {
      allow get: if true;
      allow list: if isAdmin();
      allow write: if isAdmin();
    }

    match /delegate_codes/{code} {
      allow get: if isAuthenticated();
      allow list: if isAdmin();
      allow write: if isAdmin() || (isDelegate() && request.resource.data.className == getUserClass());
    }

    match /exams/{examId} {
      allow read: if isAuthenticated() && (isAdmin() || resource.data.className == getUserClass());
      allow create: if isDelegate() || isAdmin();
      allow update, delete: if isAdmin() || (isDelegate() && resource.data.userId == request.auth.uid);
    }

    match /meetings/{meetingId} {
      allow read: if isAuthenticated() && (isAdmin() || resource.data.className == getUserClass());
      allow create: if isDelegate() || isAdmin();
      allow update, delete: if isAdmin() || (isDelegate() && resource.data.userId == request.auth.uid);
    }

    match /polls/{pollId} {
      allow read: if isAuthenticated() && (isAdmin() || resource.data.className == getUserClass());
      allow create: if (isDelegate() || isAdmin()) && 
                      request.resource.data.userId == request.auth.uid &&
                      request.resource.data.totalVotes == 0 &&
                      request.resource.data.isActive == true;
      allow update: if isAdmin() || (isDelegate() && resource.data.userId == request.auth.uid) ||
                      (isAuthenticated() && 
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['totalVotes', 'updatedAt']) &&
                       (request.resource.data.totalVotes == resource.data.totalVotes + 1 || request.resource.data.totalVotes == resource.data.totalVotes));
      allow delete: if isAdmin() || (isDelegate() && resource.data.userId == request.auth.uid);
    }

    match /resources/{resId} {
      allow read: if isAuthenticated() && (isAdmin() || resource.data.className == getUserClass());
      allow create: if isDelegate() || isAdmin();
      allow update, delete: if isAdmin() || (isDelegate() && resource.data.userId == request.auth.uid);
    }

    match /posts/{postId} {
      allow read: if isAuthenticated() && (isAdmin() || resource.data.className == getUserClass());
      allow create: if isAuthenticated() && 
                      (isAdmin() || request.resource.data.className == getUserClass()) &&
                      isValidString(request.resource.data.content, 5000) &&
                      isValidString(request.resource.data.title, 200);
      allow update: if isAdmin() || isOwner(resource.data.userId) || 
                      (isAuthenticated() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['votesScore', 'commentsCount', 'updatedAt']));
      allow delete: if isAdmin() || isOwner(resource.data.userId);
    }

    match /comments/{commentId} {
      allow read: if isAuthenticated() && (isAdmin() || resource.data.get('className', '') == getUserClass() || resource.data.get('postId', '') != '');
      allow create: if isAuthenticated() && isValidString(request.resource.data.content, 1000);
      allow update: if isAdmin() || isOwner(resource.data.userId) ||
                      (isAuthenticated() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['votesScore', 'updatedAt']));
      allow delete: if isAdmin() || isOwner(resource.data.userId);
    }

    match /notifications/{notifId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    match /activity_logs/{logId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    match /announcement_read_statuses/{statusId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || 
        isAdmin() ||
        (isDelegate() && get(/databases/$(database)/documents/announcements/$(resource.data.announcementId)).data.userId == request.auth.uid)
      );
      allow create, update: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow delete: if isAdmin() || 
                      (isAuthenticated() && resource.data.userId == request.auth.uid) ||
                      (isDelegate() && get(/databases/$(database)/documents/announcements/$(resource.data.announcementId)).data.userId == request.auth.uid);
    }

    match /votes/{voteId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
    }

    match /poll_options/{optionId} {
      allow read: if isAuthenticated();
      allow create: if isDelegate() || isAdmin();
      allow update: if isAuthenticated() && 
                      request.resource.data.diff(resource.data).affectedKeys().hasOnly(['votes']) &&
                      (request.resource.data.votes == resource.data.votes + 1 || request.resource.data.votes == resource.data.votes - 1);
      allow delete: if isAdmin() || 
                      (isDelegate() && get(/databases/$(database)/documents/polls/$(resource.data.pollId)).data.userId == request.auth.uid);
    }

    match /poll_votes/{voteId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow delete: if isAdmin() || 
                      (isAuthenticated() && resource.data.userId == request.auth.uid) ||
                      (isDelegate() && get(/databases/$(database)/documents/polls/$(resource.data.pollId)).data.userId == request.auth.uid);
    }

    match /messages/{messageId} {
      allow read: if isAuthenticated() && (isAdmin() || resource.data.className == getUserClass());
      allow create: if isAuthenticated() && 
                      (isAdmin() || request.resource.data.className == getUserClass()) &&
                      request.resource.data.userId == request.auth.uid &&
                      (
                        (request.resource.data.type == 'text' && isValidString(request.resource.data.text, 2000)) ||
                        (request.resource.data.type == 'sticker' && isValidUrl(request.resource.data.stickerUrl)) ||
                        (request.resource.data.type == 'media')
                      );
      allow update: if isAdmin() || (isAuthenticated() && 
                      request.resource.data.userId == resource.data.userId &&
                      request.resource.data.className == resource.data.className &&
                      request.resource.data.type == resource.data.type &&
                      request.resource.data.get('text', '') == resource.data.get('text', '') &&
                      request.resource.data.get('stickerUrl', '') == resource.data.get('stickerUrl', '') &&
                      request.resource.data.get('mediaUrl', '') == resource.data.get('mediaUrl', '')
                    );
      allow delete: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
    }

    match /typing/{userId} {
      allow read: if isAuthenticated() && (isAdmin() || resource.data.className == getUserClass());
      allow write: if isOwner(userId);
    }
  }
}
